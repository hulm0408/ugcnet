generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ═══════════════════════════════════════════════════
// OFFICIAL SYLLABUS
// ═══════════════════════════════════════════════════

model SyllabusUnit {
  id              String   @id @default(cuid())
  unit_number     Int      @unique
  name_arabic     String
  name_english    String
  slug            String   @unique
  description_arabic  String?
  description_english String?
  is_active       Boolean  @default(true)
  order_index     Int
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  broad_topics    BroadTopic[]
  questions       Question[]
}

model BroadTopic {
  id              String       @id @default(cuid())
  unit_id         String
  unit            SyllabusUnit @relation(fields: [unit_id], references: [id])
  name_arabic     String
  name_english    String
  slug            String
  is_active       Boolean      @default(true)
  order_index     Int
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  subtopics       Subtopic[]
  questions       Question[]

  @@unique([unit_id, slug])
}

model Subtopic {
  id              String      @id @default(cuid())
  broad_topic_id  String
  broad_topic     BroadTopic  @relation(fields: [broad_topic_id], references: [id])
  name_arabic     String
  name_english    String
  slug            String
  node_type       String      // official_topic | subtopic | entity | category
  node_source     String      // official | dynamic | generated
  is_active       Boolean     @default(true)
  order_index     Int         @default(0)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  questions       Question[]

  @@unique([broad_topic_id, slug])
}

// ═══════════════════════════════════════════════════
// EXAM PAPERS + QUESTIONS (SOURCE DATA — IMMUTABLE)
// ═══════════════════════════════════════════════════

model ExamPaper {
  id                  String   @id @default(cuid())
  source_file_name    String
  exam_name           String
  subject             String   @default("Arabic (Code No. 029)")
  paper_number        String   // "II" | "III"
  year                Int
  session             String?  // "June" | "Dec" | "Jan" | "Nov"
  part                String?  // "Part 1" | "Part 2" | null
  exam_date           String?
  total_questions     Int
  content_status      String   @default("PUBLISHED") // PUBLISHED|DRAFT|PRIVATE|UNVERIFIED|RESTRICTED|ARCHIVED
  status_reason       String?  // Why it's restricted/unverified
  is_paper_iii        Boolean  @default(false)
  display_name        String   // Human-readable name for UI
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  questions           Question[]
  import_jobs         ImportJob[]

  @@index([year, content_status])
  @@index([content_status])
}

model Question {
  id                          String   @id @default(cuid())
  source_question_id          String   @unique  // Original ID or generated NET_YYYY_Px_Qnnn
  source_file_name            String
  exam_paper_id               String
  exam_paper                  ExamPaper @relation(fields: [exam_paper_id], references: [id])
  original_question_number    String
  
  // ── IMMUTABLE SOURCE CONTENT ──────────────────────
  question_arabic             String
  question_english            String?
  question_type               String   @default("Direct MCQ")
  context_paragraph_arabic    String?
  context_paragraph_english   String?
  matching_table_arabic       Json?
  matching_table_english      Json?
  options_arabic              Json     // {A: str, B: str, C: str, D: str}
  options_english             Json?
  options_generated           Boolean  @default(false)
  correct_answer              String   // "A" | "B" | "C" | "D"
  correct_answer_text_arabic  String?
  correct_answer_text_english String?
  explanation_arabic          String?  // Legacy schema only
  explanation_english         String?  // Legacy schema only
  
  // ── ADMIN-EDITABLE CLASSIFICATION ─────────────────
  unit_id                     String?
  unit                        SyllabusUnit? @relation(fields: [unit_id], references: [id])
  broad_topic_id              String?
  broad_topic                 BroadTopic? @relation(fields: [broad_topic_id], references: [id])
  subtopic_id                 String?
  subtopic                    Subtopic? @relation(fields: [subtopic_id], references: [id])
  specific_entity_name_arabic  String?
  specific_entity_name_english String?
  question_micro_focus_arabic  String?
  question_micro_focus_english String?
  folder_path_arabic           String?
  folder_path_english          String?
  final_folder_arabic          String?
  final_folder_english         String?
  final_folder_type            String?
  
  // ── STATUS ────────────────────────────────────────
  content_status              String   @default("PUBLISHED")
  classification_status       String   @default("classified") // classified|unclassified|pending_review
  import_job_id               String?
  import_job                  ImportJob? @relation(fields: [import_job_id], references: [id])
  
  created_at                  DateTime @default(now())
  updated_at                  DateTime @updatedAt

  // Relations
  practice_attempts           PracticeAttempt[]
  bookmarks                   Bookmark[]
  reports                     QuestionReport[]
  classification_history      ClassificationHistory[]
  memory_connections          MemoryConnection[]
  source_connections          QuestionConnection[]   @relation("SourceConnections")
  target_connections          QuestionConnection[]   @relation("TargetConnections")
  spaced_memory_queue         SpacedMemoryQueue[]
  memory_review_logs          MemoryReviewLog[]

  @@index([exam_paper_id, content_status])
  @@index([unit_id, content_status])
  @@index([broad_topic_id])
  @@index([content_status])
  @@index([question_type])
}

// ═══════════════════════════════════════════════════
// USERS + AUTH (NextAuth.js tables)
// ═══════════════════════════════════════════════════

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  passwordHash  String?   @map("password_hash")
  role          String    @default("USER")  // USER | ADMIN | SUPER_ADMIN
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  lastActiveAt  DateTime? @map("last_active_at")

  accounts      Account[]
  sessions      Session[]
  
  practice_sessions PracticeSession[]
  bookmarks       Bookmark[]
  reports         QuestionReport[]
  audit_logs      AuditLog[]
  classification_history ClassificationHistory[]
  memory_connections     MemoryConnection[]
  question_connections   QuestionConnection[]
  spaced_memory_queue    SpacedMemoryQueue[]
  memory_review_logs     MemoryReviewLog[]

  @@map("User")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("Account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("Session")
}

model VerificationToken {
  identifier  String
  token       String   @unique
  expires     DateTime

  @@unique([identifier, token])
  @@map("VerificationToken")
}

// ═══════════════════════════════════════════════════
// PRACTICE ENGINE
// ═══════════════════════════════════════════════════

model PracticeSession {
  id              String    @id @default(cuid())
  user_id         String
  user            User      @relation(fields: [user_id], references: [id])
  
  mode            String    // year_wise|unit_wise|topic_wise|mixed|incorrect|bookmarked|unattempted|custom
  filters         Json?     // {year, unit_id, topic_id, paper_id, question_type, ...}
  question_ids    Json      // ordered array of question IDs for this session
  total_questions Int
  current_index   Int       @default(0)
  
  status          String    @default("in_progress") // in_progress|completed|abandoned
  score           Int       @default(0)
  correct_count   Int       @default(0)
  incorrect_count Int       @default(0)
  skipped_count   Int       @default(0)
  
  started_at      DateTime  @default(now())
  completed_at    DateTime?
  last_active_at  DateTime  @default(now())

  attempts        PracticeAttempt[]

  @@index([user_id, status])
  @@index([user_id, started_at])
}

model PracticeAttempt {
  id              String   @id @default(cuid())
  session_id      String
  session         PracticeSession @relation(fields: [session_id], references: [id])
  user_id         String
  question_id     String
  question        Question @relation(fields: [question_id], references: [id])
  
  selected_option String?  // A|B|C|D or null if skipped
  is_correct      Boolean?
  is_skipped      Boolean  @default(false)
  
  attempted_at    DateTime @default(now())

  @@unique([session_id, question_id])
  @@index([user_id, question_id])
  @@index([user_id, is_correct])
}

// ═══════════════════════════════════════════════════
// USER FEATURES
// ═══════════════════════════════════════════════════

model Bookmark {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  question_id String
  question    Question @relation(fields: [question_id], references: [id])
  created_at  DateTime @default(now())

  @@unique([user_id, question_id])
  @@index([user_id])
}

model QuestionReport {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id])
  question_id String
  question    Question @relation(fields: [question_id], references: [id])
  report_type String   // incorrect_answer|typo|unclear|wrong_classification|duplicate|formatting|other
  description String?
  status      String   @default("open") // open|reviewed|resolved|dismissed
  reviewed_by String?
  reviewed_at DateTime?
  created_at  DateTime @default(now())

  @@index([status])
  @@index([question_id])
}

// ═══════════════════════════════════════════════════
// ADMIN + AUDIT
// ═══════════════════════════════════════════════════

model ImportJob {
  id              String    @id @default(cuid())
  file_name       String
  imported_by     String
  status          String    @default("pending") // pending|validating|preview|importing|completed|failed
  total_records   Int       @default(0)
  imported_count  Int       @default(0)
  skipped_count   Int       @default(0)
  error_count     Int       @default(0)
  report          Json?     // Validation report summary
  created_at      DateTime  @default(now())
  completed_at    DateTime?

  errors          ImportError[]
  questions       Question[]
  exam_papers     ExamPaper[]
}

model ImportError {
  id            String    @id @default(cuid())
  job_id        String
  job           ImportJob @relation(fields: [job_id], references: [id])
  row_number    Int?
  error_type    String    // missing_field|duplicate_id|invalid_answer|schema_error|etc
  error_message String
  raw_data      Json?

  @@index([job_id])
}

model ClassificationHistory {
  id          String   @id @default(cuid())
  question_id String
  question    Question @relation(fields: [question_id], references: [id])
  changed_by  String
  user        User     @relation(fields: [changed_by], references: [id])
  field_name  String
  old_value   String?
  new_value   String?
  changed_at  DateTime @default(now())

  @@index([question_id])
}

model AuditLog {
  id          String   @id @default(cuid())
  user_id     String?
  user        User?    @relation(fields: [user_id], references: [id])
  action      String   // e.g. QUESTION_ARCHIVED, HIERARCHY_CHANGED, USER_ROLE_CHANGED
  entity_type String?  // Question | ExamPaper | User | SyllabusUnit | etc.
  entity_id   String?
  old_value   Json?
  new_value   Json?
  ip_address  String?
  created_at  DateTime @default(now())

  @@index([entity_type, entity_id])
  @@index([user_id])
  @@index([created_at])
}

// Simple DB-based rate limiting
model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  attempts    Int      @default(1)
  reset_at    DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([key])
  @@index([reset_at])
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  updated_by  String?
  updated_at  DateTime @updatedAt
}

// ═══════════════════════════════════════════════════
// PERSONAL MEMORY + CONNECTION ENGINE
// ═══════════════════════════════════════════════════

model MemoryConnection {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question_id String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  
  type        String   // TRICK | MNEMONIC | STORY | CONCEPT | KEYWORD | PERSONAL_EXPLANATION | VISUAL_CONNECTION
  content     String   // The personal trick, mnemonic or explanation text
  keywords    Json?    // Optional keywords/tags as array of strings
  is_public   Boolean  @default(false)
  
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@unique([user_id, question_id, type])
  @@index([user_id, question_id])
  @@index([user_id, type])
  @@index([user_id, created_at])
}

model QuestionConnection {
  id                  String   @id @default(cuid())
  user_id             String
  user                User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  source_question_id  String
  source_question     Question @relation("SourceConnections", fields: [source_question_id], references: [id], onDelete: Cascade)
  target_question_id  String
  target_question     Question @relation("TargetConnections", fields: [target_question_id], references: [id], onDelete: Cascade)
  
  relationship_type   String   @default("RELATED_CONCEPT") // SAME_AUTHOR | SAME_WORK | SAME_ERA | CONTRAST | PREREQUISITE | THEMATIC | RELATED_CONCEPT
  note                String?
  
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@unique([user_id, source_question_id, target_question_id])
  @@index([user_id, source_question_id])
  @@index([user_id, target_question_id])
}

model SpacedMemoryQueue {
  id              String    @id @default(cuid())
  user_id         String
  user            User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question_id     String
  question        Question  @relation(fields: [question_id], references: [id], onDelete: Cascade)
  
  level           Int       @default(1) // 1: 24h | 2: 3d | 3: 7d | 4: 16d | 5: 45d | 6: COMPLETED
  last_reviewed_at DateTime?
  review_count    Int       @default(0)
  difficulty      String    @default("MEDIUM") // EASY | MEDIUM | HARD
  interval_days   Int       @default(1)
  next_review_at  DateTime  @default(now())
  due_deadline    DateTime?
  memory_strength Float     @default(1.0) // 0.0 to 5.0
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | EXPIRED | ARCHIVED
  is_completed    Boolean   @default(false)
  completed_at    DateTime?
  
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@unique([user_id, question_id])
  @@index([user_id, next_review_at])
  @@index([user_id, status])
  @@index([user_id, level])
  @@index([user_id, is_completed])
}

model MemoryReviewLog {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question_id String
  question    Question @relation(fields: [question_id], references: [id], onDelete: Cascade)
  
  memory_id   String?
  was_helpful Boolean  @default(true)
  feedback    String?
  reviewed_at DateTime @default(now())

  @@index([user_id, question_id])
  @@index([user_id, reviewed_at])
}

